{
  "mcpServers": {
    "Aftermath": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["run", "--project", "src/Aftermath/Aftermath.csproj"],
      "env": {
        "INCIDENTTIMELINE_WORKSPACE": "c:\\workspace\\work",
        "INCIDENTTIMELINE_LOG_ROOT": "c:\\incident\\logs",
        "INCIDENTTIMELINE_TIMEZONE": "Europe/Dublin",
        "INCIDENTTIMELINE_LOKI_URL": "http://localhost:3100"
      }
    }
  }
}
